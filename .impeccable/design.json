  "components": [
    {
      "name": "Site Header + Nav",
      "kind": "nav",
      "refersTo": "button-primary",
      "description": "Full-width sticky dusk-indigo bar: Georgia wordmark left, small nav links right; collapses to a hamburger menu under 720px.",
      "html": "<header class=\"ds-header\"><a class=\"ds-brand\" href=\"#\">Oneiratory</a><nav class=\"ds-nav\"><a class=\"on\" href=\"#\">The instrument</a><a href=\"#\">Registry</a><a href=\"#\">Commons</a></nav></header>",
      "css": ".ds-header{background:var(--bar);display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0 24px;min-height:58px;border-bottom:1px solid #443e68}.ds-brand{font-family:var(--serif);font-size:21px;letter-spacing:.16em;color:#fff;text-decoration:none;padding:9px 0}.ds-nav{display:flex;gap:2px}.ds-nav a{font-family:var(--sans);font-size:13px;color:#cfcae6;text-decoration:none;padding:8px 12px;border-radius:var(--r-sm);transition:background .15s,color .15s}.ds-nav a:hover{background:rgba(255,255,255,.09);color:#fff}.ds-nav a.on{background:rgba(255,255,255,.15);color:#fff}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Terracotta commit button. Primary actions only (Seal a dream, Sign in).",
